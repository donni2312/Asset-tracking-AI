{
  // Debugging. Stop the "API: dev server (watch)" task first — both use port 8080.
  // The .NET configurations need the C# extension (ms-dotnettools.csharp).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build: API (dotnet build)",
      "program": "${workspaceFolder}/artifacts/api-server/src/AssetIQ.Api/bin/Debug/net8.0/AssetIQ.Api.dll",
      "cwd": "${workspaceFolder}/artifacts/api-server/src/AssetIQ.Api",
      // The API reads the repository's .env itself (DATABASE_URL, PORT, …).
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Web: debug in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/artifacts/asset-tracker"
    },
    {
      // Run `$env:VSTEST_HOST_DEBUG=1; pnpm test` in a terminal, then attach to the testhost process it prints.
      "name": "Tests: attach to the API test host",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Seed: debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "--env-file-if-exists=../.env", "src/seed.ts", "--reset"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full stack (debug API + Edge)",
      "preLaunchTask": "Dev: database + web (for API debugging)",
      "configurations": ["API: debug", "Web: debug in Edge"],
      "stopAll": true
    }
  ]
}
