{
  // Use the workspace TypeScript (5.9) so the editor matches `pnpm run typecheck`.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // The repository uses LF line endings.
  "files.eol": "\n",
  "files.exclude": {
    "**/*.tsbuildinfo": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "pnpm-lock.yaml": true
  },

  // Tailwind v4 IntelliSense: the theme lives in the CSS entry file.
  "tailwindCSS.experimental.configFile": "artifacts/asset-tracker/src/index.css",

  // REST Client (requests in artifacts/api-server/requests.http).
  "rest-client.environmentVariables": {
    "$shared": {},
    "local": { "baseUrl": "http://localhost:8080/api" },
    "via-vite-proxy": { "baseUrl": "http://localhost:5173/api" }
  },

  // Node.js was installed per-user (no admin) in %LOCALAPPDATA%\Programs\nodejs, the .NET 8 SDK in
  // %ProgramFiles%\dotnet. Prepending both lets VS Code terminals find node/pnpm/dotnet even before
  // VS Code picks up the updated PATH. Harmless on machines without those folders.
  "terminal.integrated.env.windows": {
    "PATH": "${env:LOCALAPPDATA}\\Programs\\nodejs;${env:ProgramFiles}\\dotnet;${env:PATH}"
  },

  // C# extension: the API solution.
  "dotnet.defaultSolution": "artifacts/api-server/AssetIQ.sln"
}
