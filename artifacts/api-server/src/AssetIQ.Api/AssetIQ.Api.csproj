<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AssetIQ.Api</RootNamespace>
    <AssemblyName>AssetIQ.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AssetIQ.Api.Tests" />
  </ItemGroup>

  <!-- Azure App Service: when the dashboard has been built (`pnpm build:azure` builds it first), publishing
       copies it into wwwroot so the API serves it. Build output (bin/) never gets it, so development is unchanged. -->
  <PropertyGroup>
    <DashboardDist>$(MSBuildThisFileDirectory)..\..\..\asset-tracker\dist\public\</DashboardDist>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DashboardDist)index.html')">
    <Content Include="$(DashboardDist)**\*" LinkBase="wwwroot" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
