{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AssetIQ API — ASP.NET Core 8 + EF Core 8 + PostgreSQL. These scripts let the workspace commands drive the .NET CLI.",
  "scripts": {
    "dev": "node ./dotnet.mjs watch --project src/AssetIQ.Api run --non-interactive",
    "build": "node ./dotnet.mjs publish src/AssetIQ.Api -c Release -o dist --nologo",
    "start": "node ./dotnet.mjs dist/AssetIQ.Api.dll",
    "typecheck": "node ./dotnet.mjs build AssetIQ.sln --nologo -v q",
    "test": "node ./dotnet.mjs test AssetIQ.sln --nologo",
    "test:watch": "node ./dotnet.mjs watch --project tests/AssetIQ.Api.Tests test --nologo"
  }
}
