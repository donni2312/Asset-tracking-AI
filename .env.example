# Local development settings. Copy this file to `.env` (git-ignored) and adjust.
# On Replit these values come from Secrets / the platform instead.

# PostgreSQL connection. `pnpm db:local` starts a local server and prints this exact URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/assetiq

# Port of the API server. The Vite dev server (http://localhost:5173) proxies /api to it.
PORT=8080

# Anomaly-engine rules (organisation timezone, working hours Mon-Fri 07:00-18:00 by default)
ORG_TIMEZONE=Africa/Harare
WORK_HOURS_START=7
WORK_HOURS_END=18
WORK_DAYS=1-5
IDLE_ASSET_DAYS=7

# Optional: OpenAI intent parsing for the AI assistant. Leave empty to use the rule-based
# parser only (it is also the automatic fallback when OpenAI is unavailable).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI (production target): use the v1 endpoint and key header, e.g.
#   OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   OPENAI_AUTH_HEADER=api-key
OPENAI_BASE_URL=
OPENAI_AUTH_HEADER=

# Optional: local PostgreSQL started by `pnpm db:local`
# LOCAL_PG_PORT=5433
# LOCAL_PG_DATA_DIR=C:\Users\<you>\AppData\Local\AssetIQ\pgdata
